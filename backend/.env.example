# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Postgres connection string
# Local: postgresql://user:password@localhost:5432/campanha_saas
# Railway: Will be auto-generated
DATABASE_URL="postgresql://user:password@localhost:5432/campanha_saas"

# Redis cache connection (optional)
REDIS_URL="redis://localhost:6379"

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# Server port (Railway will override this)
PORT=3001

# Node environment
NODE_ENV="development"

# Frontend URL (for CORS allowed origins)
FRONTEND_URL="http://localhost:3000"

# ============================================================
# AUTHENTICATION
# ============================================================
# JWT Secret key (⚠️ CHANGE THIS IN PRODUCTION ⚠️)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# JWT token expiration time
JWT_EXPIRATION="7d"

# ============================================================
# SOCIAL MEDIA INTEGRATIONS
# ============================================================
# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Meta Pixel (Facebook Conversion Tracking)
META_PIXEL_ID=""

# ============================================================
# EMAIL & SMS SERVICES
# ============================================================
# AWS SES (Email sending)
AWS_SES_REGION="us-east-1"
AWS_SES_ACCESS_KEY=""
AWS_SES_SECRET_KEY=""

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ============================================================
# LOGGING & MONITORING
# ============================================================
# Sentry (error tracking) - optional
SENTRY_DSN=""

# ============================================================
# RAILWAY DEPLOYMENT
# ============================================================
# These are auto-managed by Railway
RAILWAY_ENVIRONMENT="production"
RAILWAY_STATIC_URL=""
