{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "context": "."
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "/app/start.sh"
  },
  "services": [
    {
      "name": "backend",
      "build": {
        "context": "./backend",
        "dockerfile": "Dockerfile"
      },
      "port": 3000,
      "environment": {
        "NODE_ENV": "production",
        "PORT": 3000
      }
    },
    {
      "name": "frontend",
      "build": {
        "context": "./frontend",
        "dockerfile": "Dockerfile"
      },
      "port": 3000,
      "environment": {
        "NODE_ENV": "production",
        "PORT": 3000
      }
    }
  ]
}
